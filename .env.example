# 光律 GUANGLV — 本机运行，默认只监听 127.0.0.1
HOST=127.0.0.1
PORT=8000
DATA_DIR=./data

# 图纸识别：local = 本地几何分析（默认，离线可用）
RECOGNITION_PROVIDER=local
IMAGE_PROVIDER=local

# 可选：接你自己的大模型（识图/语义分析）。不填也能出图。
PLAN_VISION_PROVIDER=disabled
PLAN_VISION_URL=
PLAN_VISION_TOKEN=
AI_API_KEY=

# 上传大小上限（MB）
MAX_UPLOAD_MB=80

# 首次建库是否灌示例项目（0 = 空库）
SEED_DEMO=0

# 可选：外网访问高危操作令牌（留空 = 外网一律拒绝）
ADMIN_TOKEN=

# 检查更新用的发布仓库（默认指向作者仓库；fork 后改成自己的）
UPDATE_REPO=twbzpngd58-beep/guanglv-workbench
